\documentclass[letterpaper,11pt]{article}

\usepackage{latexsym}
\usepackage[letterpaper,margin=\VAR{typography.margin_in}in]{geometry}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}

% Ensure the generated pdf is machine readable/ATS parsable (TP-8). These are pdfTeX
% features; engines without them write their own text map.
\ifdefined\pdfgentounicode
  \input{glyphtounicode}
  \pdfgentounicode=1
\fi

\pagestyle{fancy}
\fancyhf{} % clear all header and footer fields
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

%----------TYPOGRAPHY----------
%% set base = typography.base_font_pt
\renewcommand{\normalsize}{\fontsize{\VAR{base}}{\VAR{(base * 1.2) | round(2)}}\selectfont}
\renewcommand{\small}{\fontsize{\VAR{(base * 0.91) | round(2)}}{\VAR{(base * 1.09) | round(2)}}\selectfont}
\renewcommand{\large}{\fontsize{\VAR{(base * 1.09) | round(2)}}{\VAR{(base * 1.31) | round(2)}}\selectfont}
\renewcommand{\Huge}{\fontsize{\VAR{(base * 2.26) | round(2)}}{\VAR{(base * 2.7) | round(2)}}\selectfont}
\linespread{\VAR{typography.line_spread}}
\setlist[itemize,2]{itemsep=\VAR{typography.item_sep_pt}pt}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large
}{}{0em}{}[\titlerule \vspace{-5pt}]
\titlespacing*{\section}{0pt}{\VAR{typography.section_sep_pt}pt}{8pt}

%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & #2 \\
    \end{tabular*}\vspace{-7pt}
}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

%-------------------------------------------
\begin{document}

