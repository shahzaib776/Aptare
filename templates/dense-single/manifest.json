{
  "id": "dense-single",
  "name": "Dense single column (Jake's resume)",
  "license": "MIT (Jake Gutierrez, based on sb2nov/resume)",
  "fields": [
    "headline",
    "email",
    "phone",
    "location",
    "summary",
    "linkedin",
    "github",
    "website",
    "other"
  ],
  "sections": [
    { "key": "education", "column": "main", "movable": true, "required": false },
    { "key": "experience", "column": "main", "movable": true, "required": true },
    { "key": "projects", "column": "main", "movable": true, "required": false },
    { "key": "skills", "column": "main", "movable": true, "required": false }
  ],
  "typography_defaults": {
    "base_font_pt": 10.0,
    "line_spread": 1.0,
    "margin_in": 0.5,
    "item_sep_pt": 2.0,
    "section_sep_pt": 6.0
  },
  "typography_bounds": {
    "base_font_pt": [8.5, 11.0],
    "line_spread": [0.9, 1.15],
    "margin_in": [0.3, 1.0],
    "item_sep_pt": [0.0, 6.0],
    "section_sep_pt": [2.0, 12.0]
  }
}
