ENV=development
DATA_DIR=./data
DB_URL=sqlite:///./data/app.db
# `make dev` sets its own values for all of these. For running the API by hand, point this at the
# worker you started yourself, e.g. http://localhost:8001 (compose's name `compiler` only exists
# inside Docker).
COMPILER_URL=http://compiler:8001
LLM_PROVIDER=fake
